# RENDER BACKEND CONFIG — enter these in Render Environment, not in source control.
ALRYN_BACKEND_SHARED_SECRET=use_the_same_random_secret_as_the_bot_config_at_least_32_chars
ALRYN_BACKEND_MAX_PROMPT_CHARS=12000
ALRYN_BACKEND_REQUEST_TIMEOUT_SECONDS=45
ALRYN_BACKEND_MAX_HISTORY_MESSAGES=12
ALRYN_BACKEND_REQUESTS_PER_MINUTE=90

# Provider keys: store only in Render Environment. Never place them on Pterodactyl.
