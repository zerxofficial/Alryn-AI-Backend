# Configure the correct model IDs after verifying access in each account.
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=
MISTRAL_MODEL=mistral-small-latest
